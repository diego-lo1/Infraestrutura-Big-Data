<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🎮 MISSÃO LINUX — Semana 01 | Big Data Academy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Orbitron:wght@400;700;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #080c10;
            --surface: #0d1117;
            --surface2: #161b22;
            --border: #21262d;
            --accent: #00ff9d;
            --accent2: #00b4ff;
            --accent3: #ff6b35;
            --warn: #ffd700;
            --danger: #ff4444;
            --text: #e6edf3;
            --muted: #7d8590;
            --xp-color: #ffd700;
            --green: #3fb950;
            --purple: #bc8cff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* ── SCANLINE EFFECT ── */
        body::before {
            content: '';
            position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,255,157,0.01) 2px, rgba(0,255,157,0.01) 4px);
            pointer-events: none;
            z-index: 9999;
        }

        /* ── HEADER ── */
        .hud-header {
            background: linear-gradient(180deg, #0a1628 0%, var(--surface) 100%);
            border-bottom: 1px solid var(--accent);
            box-shadow: 0 0 30px rgba(0,255,157,0.15);
            position: sticky; top: 0; z-index: 1000;
            padding: 0;
        }
        .hud-top {
            display: flex; align-items: center; gap: 20px;
            max-width: 1300px; margin: 0 auto;
            padding: 12px 24px;
        }
        .hud-logo {
            font-family: 'Orbitron', monospace;
            font-size: 1.1em; font-weight: 900;
            color: var(--accent);
            text-shadow: 0 0 20px rgba(0,255,157,0.5);
            white-space: nowrap;
        }
        .hud-logo span { color: var(--accent2); }
        .hud-divider { width: 1px; height: 36px; background: var(--border); }

        .player-hud {
            display: flex; align-items: center; gap: 16px;
            flex: 1;
        }
        .player-avatar {
            width: 38px; height: 38px;
            border-radius: 8px;
            background: linear-gradient(135deg, #00ff9d22, #00b4ff22);
            border: 1.5px solid var(--accent);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3em;
        }
        .player-info { flex: 1; min-width: 0; }
        .player-name {
            font-family: 'Orbitron', monospace;
            font-size: 0.7em; color: var(--accent);
            letter-spacing: 1px;
        }
        .player-level {
            font-size: 0.72em; color: var(--muted);
        }

        .xp-bar-wrap {
            flex: 1; max-width: 220px;
        }
        .xp-label {
            display: flex; justify-content: space-between;
            font-size: 0.65em; color: var(--muted);
            margin-bottom: 4px; font-family: 'JetBrains Mono', monospace;
        }
        .xp-bar {
            height: 6px; background: var(--border);
            border-radius: 3px; overflow: hidden;
        }
        .xp-fill {
            height: 100%; width: 0%;
            background: linear-gradient(90deg, var(--accent), var(--accent2));
            border-radius: 3px;
            transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
            box-shadow: 0 0 8px rgba(0,255,157,0.5);
        }

        .xp-total-badge {
            background: rgba(255, 215, 0, 0.1);
            border: 1px solid var(--warn);
            border-radius: 20px;
            padding: 4px 14px;
            font-family: 'Orbitron', monospace;
            font-size: 0.7em;
            color: var(--warn);
            white-space: nowrap;
            text-shadow: 0 0 10px rgba(255,215,0,0.4);
        }
        .xp-total-badge span { font-weight: 700; font-size: 1.1em; }

        .header-back {
            background: rgba(255,255,255,0.05);
            color: var(--muted);
            text-decoration: none;
            padding: 7px 16px;
            border-radius: 6px;
            font-size: 0.8em;
            border: 1px solid var(--border);
            transition: all 0.2s;
            white-space: nowrap;
        }
        .header-back:hover { color: var(--text); border-color: var(--accent); }

        /* ── MISSION STATUS BAR ── */
        .mission-bar {
            background: rgba(0,0,0,0.4);
            border-top: 1px solid var(--border);
            padding: 7px 24px;
        }
        .mission-bar-inner {
            max-width: 1300px; margin: 0 auto;
            display: flex; align-items: center; gap: 20px;
            font-size: 0.72em; font-family: 'JetBrains Mono', monospace;
        }
        .mission-status-dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 6px var(--accent);
            animation: pulse-dot 2s infinite;
        }
        @keyframes pulse-dot {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }
        .mission-label { color: var(--muted); }
        .mission-name { color: var(--accent); font-weight: 700; }
        .mission-progress-text { margin-left: auto; color: var(--warn); }

        /* ── LAYOUT ── */
        .main-layout {
            max-width: 1300px; margin: 0 auto;
            padding: 28px 20px;
            display: flex; gap: 24px;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 260px; flex-shrink: 0;
        }
        .sidebar-panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 18px;
            margin-bottom: 16px;
            position: sticky; top: 100px;
        }
        .panel-title {
            font-family: 'Orbitron', monospace;
            font-size: 0.65em; letter-spacing: 2px;
            color: var(--accent); text-transform: uppercase;
            margin-bottom: 14px;
            display: flex; align-items: center; gap: 8px;
        }
        .panel-title::after {
            content: ''; flex: 1; height: 1px;
            background: linear-gradient(90deg, var(--border), transparent);
        }

        /* Mission Nav */
        .mission-nav { list-style: none; }
        .mission-nav li { margin-bottom: 4px; }
        .mission-nav a {
            display: flex; align-items: center; gap: 10px;
            padding: 8px 10px; border-radius: 6px;
            text-decoration: none; font-size: 0.82em;
            color: var(--muted);
            border: 1px solid transparent;
            transition: all 0.2s;
        }
        .mission-nav a:hover {
            background: rgba(0,255,157,0.05);
            border-color: rgba(0,255,157,0.2);
            color: var(--text);
        }
        .mission-nav a.active {
            background: rgba(0,255,157,0.08);
            border-color: var(--accent);
            color: var(--accent);
        }
        .mission-nav a.completed {
            color: var(--green);
        }
        .mission-nav a.completed .nav-badge { background: var(--green); color: #000; }
        .nav-badge {
            background: var(--border);
            color: var(--muted);
            border-radius: 4px;
            padding: 1px 7px;
            font-size: 0.72em;
            font-family: 'JetBrains Mono', monospace;
            flex-shrink: 0;
            min-width: 24px; text-align: center;
        }
        .nav-xp {
            margin-left: auto;
            font-size: 0.68em;
            font-family: 'JetBrains Mono', monospace;
            color: var(--warn);
            opacity: 0.7;
        }

        /* Achievements */
        .achievement-list {
            display: flex; flex-direction: column; gap: 8px;
        }
        .achievement {
            display: flex; align-items: center; gap: 10px;
            padding: 8px 10px; border-radius: 6px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            font-size: 0.78em;
            opacity: 0.4;
            transition: all 0.5s;
        }
        .achievement.unlocked {
            opacity: 1;
            border-color: var(--warn);
            background: rgba(255,215,0,0.05);
            animation: achievement-glow 0.5s ease;
        }
        @keyframes achievement-glow {
            0% { transform: scale(1.05); box-shadow: 0 0 20px rgba(255,215,0,0.4); }
            100% { transform: scale(1); box-shadow: none; }
        }
        .ach-icon { font-size: 1.4em; flex-shrink: 0; }
        .ach-name { font-weight: 600; color: var(--text); font-size: 0.95em; }
        .ach-desc { color: var(--muted); font-size: 0.85em; }

        /* Rank */
        .rank-display {
            text-align: center; padding: 10px 0;
        }
        .rank-icon {
            font-size: 3em; margin-bottom: 8px;
            filter: grayscale(0.3);
        }
        .rank-title {
            font-family: 'Orbitron', monospace;
            font-size: 0.85em; font-weight: 700;
            color: var(--warn);
            text-shadow: 0 0 10px rgba(255,215,0,0.4);
        }
        .rank-sub { font-size: 0.72em; color: var(--muted); margin-top: 4px; }

        /* ── CONTENT ── */
        .content { flex: 1; min-width: 0; }

        /* ── HERO MISSION BRIEF ── */
        .mission-brief {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 28px 32px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
        }
        .mission-brief::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0; height: 2px;
            background: linear-gradient(90deg, var(--accent), var(--accent2), var(--purple));
        }
        .mission-brief::after {
            content: 'BIG DATA ACADEMY';
            position: absolute; right: -20px; top: 50%; transform: translateY(-50%) rotate(90deg);
            font-family: 'Orbitron', monospace;
            font-size: 0.5em; letter-spacing: 4px; color: rgba(255,255,255,0.03);
            white-space: nowrap; pointer-events: none;
        }
        .brief-tag {
            display: inline-flex; align-items: center; gap: 6px;
            background: rgba(0,255,157,0.08);
            border: 1px solid rgba(0,255,157,0.2);
            border-radius: 20px;
            padding: 3px 14px;
            font-size: 0.72em;
            font-family: 'JetBrains Mono', monospace;
            color: var(--accent);
            margin-bottom: 14px;
            letter-spacing: 1px;
        }
        .brief-title {
            font-family: 'Orbitron', monospace;
            font-size: 1.6em; font-weight: 900;
            line-height: 1.2; margin-bottom: 10px;
            background: linear-gradient(135deg, var(--text) 0%, var(--accent2) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .brief-meta {
            font-size: 0.82em; color: var(--muted);
            margin-bottom: 20px;
        }
        .brief-chips {
            display: flex; flex-wrap: wrap; gap: 8px;
        }
        .brief-chip {
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 5px 14px;
            font-size: 0.78em;
            display: flex; align-items: center; gap: 6px;
            font-family: 'JetBrains Mono', monospace;
        }
        .brief-chip.green { border-color: rgba(0,255,157,0.3); color: var(--accent); }
        .brief-chip.blue { border-color: rgba(0,180,255,0.3); color: var(--accent2); }
        .brief-chip.orange { border-color: rgba(255,107,53,0.3); color: var(--accent3); }

        /* ── OBJECTIVE BOX ── */
        .obj-card {
            background: rgba(0,180,255,0.05);
            border: 1px solid rgba(0,180,255,0.2);
            border-radius: 10px;
            padding: 18px 22px;
            margin-bottom: 24px;
        }
        .obj-card-title {
            font-family: 'Orbitron', monospace;
            font-size: 0.7em; letter-spacing: 2px;
            color: var(--accent2);
            margin-bottom: 12px;
            display: flex; align-items: center; gap: 8px;
        }
        .obj-list { list-style: none; padding: 0; }
        .obj-list li {
            display: flex; align-items: flex-start; gap: 10px;
            font-size: 0.88em; color: var(--text);
            padding: 6px 0;
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }
        .obj-list li:last-child { border-bottom: none; }
        .obj-list li::before {
            content: '▸'; color: var(--accent2);
            flex-shrink: 0; margin-top: 1px;
        }

        /* ── GLOBAL PROGRESS ── */
        .global-progress {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 18px 22px;
            margin-bottom: 24px;
        }
        .prog-header {
            display: flex; justify-content: space-between;
            align-items: center; margin-bottom: 14px;
        }
        .prog-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72em; color: var(--muted);
        }
        .prog-count {
            font-family: 'Orbitron', monospace;
            font-size: 0.8em; color: var(--accent);
            font-weight: 700;
        }
        .prog-segments {
            display: flex; gap: 5px; margin-bottom: 10px;
        }
        .prog-seg {
            flex: 1; height: 10px; border-radius: 4px;
            background: var(--border); cursor: pointer;
            transition: all 0.3s; position: relative;
        }
        .prog-seg.done { background: linear-gradient(90deg, var(--accent), var(--green)); box-shadow: 0 0 8px rgba(0,255,157,0.3); }
        .prog-seg:hover { transform: scaleY(1.3); }
        .prog-seg-labels {
            display: flex; gap: 5px;
        }
        .prog-seg-label {
            flex: 1; font-size: 0.6em; color: var(--muted);
            font-family: 'JetBrains Mono', monospace;
            text-align: center; cursor: pointer; transition: color 0.2s;
        }
        .prog-seg-label:hover, .prog-seg.done + .prog-seg-label { color: var(--accent); }

        /* ── MISSION SECTION ── */
        .mission-section {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            margin-bottom: 16px;
            overflow: hidden;
            scroll-margin-top: 110px;
            transition: border-color 0.3s;
        }
        .mission-section.completed {
            border-color: rgba(0,255,157,0.3);
        }
        .mission-head {
            display: flex; align-items: center; gap: 14px;
            padding: 16px 20px;
            cursor: pointer; user-select: none;
            background: rgba(255,255,255,0.02);
            border-bottom: 1px solid var(--border);
            transition: background 0.2s;
        }
        .mission-head:hover { background: rgba(255,255,255,0.04); }
        .mission-section.completed .mission-head { background: rgba(0,255,157,0.03); }

        .mission-num {
            font-family: 'Orbitron', monospace;
            font-size: 0.75em; font-weight: 700;
            background: var(--border);
            border-radius: 6px;
            width: 36px; height: 36px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            color: var(--muted);
            border: 1px solid transparent;
        }
        .mission-section.completed .mission-num {
            background: rgba(0,255,157,0.1);
            border-color: var(--accent);
            color: var(--accent);
        }
        .mission-info { flex: 1; min-width: 0; }
        .mission-title {
            font-size: 0.96em; font-weight: 600; color: var(--text);
            margin-bottom: 2px;
        }
        .mission-subtitle {
            font-size: 0.72em; font-family: 'JetBrains Mono', monospace;
            color: var(--muted);
        }
        .mission-xp-badge {
            background: rgba(255,215,0,0.08);
            border: 1px solid rgba(255,215,0,0.2);
            border-radius: 20px;
            padding: 4px 14px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72em; color: var(--warn);
            white-space: nowrap;
            flex-shrink: 0;
        }
        .mission-xp-badge.earned {
            background: rgba(255,215,0,0.15);
            border-color: var(--warn);
            box-shadow: 0 0 8px rgba(255,215,0,0.2);
        }
        .mission-chevron {
            color: var(--muted); font-size: 0.75em;
            transition: transform 0.3s; flex-shrink: 0;
        }
        .mission-chevron.open { transform: rotate(180deg); }

        .mission-body { padding: 24px; display: none; }
        .mission-body.open { display: block; }

        /* ── STEP CARD ── */
        .step-card {
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 18px 20px;
            margin-bottom: 16px;
        }
        .step-header {
            font-size: 0.9em; font-weight: 600;
            color: var(--text); margin-bottom: 8px;
            display: flex; align-items: center; gap: 8px;
        }
        .step-num-small {
            background: var(--surface2);
            color: var(--muted);
            border-radius: 4px;
            width: 22px; height: 22px;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.75em;
            font-family: 'JetBrains Mono', monospace;
            flex-shrink: 0;
        }
        .step-desc { font-size: 0.86em; color: var(--muted); margin-bottom: 12px; }

        /* ── CODE BLOCK ── */
        .code-block {
            background: #010409;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 14px 16px 14px 16px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.84em;
            position: relative;
            margin: 10px 0 14px;
            overflow-x: auto;
        }
        .code-block::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent2), transparent);
            opacity: 0.3;
        }
        .code-line { display: flex; gap: 10px; margin-bottom: 4px; align-items: flex-start; }
        .prompt { color: var(--accent); user-select: none; flex-shrink: 0; }
        .cmd { color: #79c0ff; }
        .cmt { color: #484f58; font-style: italic; }
        .copy-btn {
            position: absolute; top: 10px; right: 12px;
            background: rgba(255,255,255,0.06); color: var(--muted);
            border: 1px solid var(--border);
            border-radius: 5px; padding: 3px 12px;
            font-size: 0.72em; font-family: 'JetBrains Mono', monospace;
            cursor: pointer; transition: all 0.2s;
        }
        .copy-btn:hover { background: rgba(255,255,255,0.1); color: var(--text); }
        .copy-btn.copied { background: rgba(0,255,157,0.1); color: var(--accent); border-color: var(--accent); }

        /* ── INFO BOXES ── */
        .info-box {
            border-radius: 8px; padding: 14px 18px;
            font-size: 0.87em; margin-top: 14px;
            display: flex; gap: 12px; align-items: flex-start;
        }
        .info-box-icon { font-size: 1.2em; flex-shrink: 0; margin-top: 1px; }
        .info-box-content strong {
            display: block; margin-bottom: 4px; font-size: 0.95em;
        }
        .info-box.green {
            background: rgba(63,185,80,0.08);
            border: 1px solid rgba(63,185,80,0.25);
            color: #7ee787;
        }
        .info-box.yellow {
            background: rgba(255,215,0,0.06);
            border: 1px solid rgba(255,215,0,0.2);
            color: #e3b341;
        }
        .info-box.blue {
            background: rgba(0,180,255,0.07);
            border: 1px solid rgba(0,180,255,0.2);
            color: #79c0ff;
        }
        .info-box.red {
            background: rgba(255,68,68,0.07);
            border: 1px solid rgba(255,68,68,0.2);
            color: #ff7b7b;
        }

        .chip-inline {
            display: inline-block;
            background: rgba(255,255,255,0.06);
            border: 1px solid var(--border);
            border-radius: 4px; padding: 1px 8px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.86em; color: var(--purple);
        }

        /* ── COMPLETE BUTTON ── */
        .complete-mission-btn {
            display: flex; align-items: center; justify-content: center; gap: 10px;
            width: 100%; padding: 14px;
            background: rgba(0,255,157,0.07);
            border: 1.5px solid rgba(0,255,157,0.3);
            border-radius: 8px;
            font-family: 'Orbitron', monospace;
            font-size: 0.8em; font-weight: 700;
            color: var(--accent);
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 20px;
            letter-spacing: 1px;
        }
        .complete-mission-btn:hover {
            background: rgba(0,255,157,0.12);
            border-color: var(--accent);
            box-shadow: 0 0 20px rgba(0,255,157,0.2);
            transform: translateY(-1px);
        }
        .complete-mission-btn.done {
            background: rgba(0,255,157,0.1);
            border-color: var(--accent);
            color: var(--accent);
            cursor: default; pointer-events: none;
        }
        .complete-mission-btn:disabled { opacity: 0.6; }

        /* ── QUIZ ── */
        .quiz-card {
            background: rgba(188,140,255,0.05);
            border: 1px solid rgba(188,140,255,0.2);
            border-radius: 8px;
            padding: 20px 22px;
            margin-top: 14px;
        }
        .quiz-title {
            font-family: 'Orbitron', monospace;
            font-size: 0.7em; letter-spacing: 2px;
            color: var(--purple); margin-bottom: 14px;
            display: flex; align-items: center; gap: 8px;
        }
        .quiz-question {
            font-size: 0.9em; color: var(--text);
            margin-bottom: 14px; font-weight: 500;
            line-height: 1.5;
        }
        .quiz-options { display: flex; flex-direction: column; gap: 8px; }
        .quiz-opt {
            padding: 10px 14px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 0.85em; color: var(--muted);
            cursor: pointer; transition: all 0.2s;
            text-align: left;
        }
        .quiz-opt:hover { border-color: var(--purple); color: var(--text); background: rgba(188,140,255,0.05); }
        .quiz-opt.correct { border-color: var(--green); color: var(--green); background: rgba(63,185,80,0.08); }
        .quiz-opt.wrong { border-color: var(--danger); color: var(--danger); background: rgba(255,68,68,0.08); }
