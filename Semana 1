            updateLevel();
        }

        function showXPPopup(amount, mission) {
            const popup = document.getElementById('xpPopup');
            document.getElementById('xpPopupAmount').textContent = '+' + amount + ' XP';
            document.getElementById('xpPopupMission').textContent = mission || '';
            popup.classList.add('show');
            setTimeout(() => popup.classList.remove('show'), 3000);
        }

        function unlockAchievement(key) {
            if (state.achievements.has(key)) return;
            state.achievements.add(key);

            const ach = achievements[key];
            const el = document.getElementById('ach-' + key);
            if (el) el.classList.add('unlocked');

            const popup = document.getElementById('achPopup');
            document.getElementById('achPopupIcon').textContent = ach.icon;
            document.getElementById('achPopupName').textContent = ach.name;
            document.getElementById('achPopupDesc').textContent = ach.desc;
            popup.classList.add('show');
            setTimeout(() => popup.classList.remove('show'), 4000);
        }

        function updateXP() {
            const maxXP = 350;
            const fill = document.getElementById('xpFill');
            const pct = Math.min(100, (state.xp / maxXP) * 100);
            fill.style.width = pct + '%';
            document.getElementById('xpBarText').textContent = state.xp + ' / ' + maxXP;
            document.getElementById('xpTotal').textContent = state.xp;
        }

        function updateLevel() {
            let current = levels[0];
            for (const lvl of levels) {
                if (state.xp >= lvl.min) current = lvl;
            }
            document.getElementById('playerLevel').textContent = 'Nível ' + (levels.indexOf(current) + 1) + ' — ' + current.title;
            document.getElementById('rankTitle').textContent = current.rank;
            document.getElementById('rankSub').textContent = current.sub;
            document.querySelector('#rankDisplay .rank-icon').textContent = current.icon;
        }

        // ── SCROLL TOC HIGHLIGHT ──
        const sections = document.querySelectorAll('.mission-section, .delivery-section');
        const navLinks = document.querySelectorAll('.mission-nav a');
        window.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(s => {
                if (window.scrollY >= s.offsetTop - 130) current = s.id;
            });
            navLinks.forEach(a => {
                const href = a.getAttribute('href').replace('#', '');
                a.classList.toggle('active', href === current);
            });
        });

        // Init
        updateXP();
        updateLevel();
    </script>
</body>
</html>
